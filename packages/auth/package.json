{
	"name": "@socket-mesh/auth",
	"version": "2.2.2",
	"description": "Auth module for SocketMesh",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": ["./dist"],
	"scripts": {
		"build": "node ../../scripts/build.mjs && tsc --project tsconfig.build.json",
		"deploy": "node ../../scripts/publish.mjs",
		"lint": "eslint . --c ../../eslint.config.mjs",
		"lint:fix": "eslint . --c ../../eslint.config.mjs --fix",
		"test": "tsx --tsconfig ./tsconfig.build.json --test ./src/**/*.{spec,test}.ts ./test/**/*.{spec,test}.ts"
	},
	"keywords": [
		"auth",
		"jwt",
		"socketMesh"
	],
	"author": "Greg Kimmy",
	"license": "MIT",
	"homepage": "https://github.com/socket-mesh/main/tree/main/packages/auth#README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/socket-mesh/client-server.git"
	},
	"bugs": {
		"url": "https://github.com/socket-mesh/client-server/labels/auth"
	},
	"devDependencies": {
		"@socket-mesh/typescript-config": "workspace:^"
	}
}
